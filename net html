<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Net Profit - DHAN SIOMAI</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',sans-serif}
body{background:#FFF8E1;padding:15px}
.header{background:#D32F2F;color:white;padding:15px;border-radius:12px;display:flex;justify-content:space-between;align-items:center;margin-bottom:15px}
.header h1{font-size:18px}
.back-btn{color:#D32F2F;background:white;text-decoration:none;font-weight:600;padding:8px 14px;border-radius:8px;font-size:13px}
.card{background:white;border-radius:16px;padding:20px;margin-bottom:15px;box-shadow:0 2px 8px rgba(0,0,0,0.1)}
.card h3{color:#D32F2F;margin-bottom:15px;font-size:16px}
.filter-row{display:flex;gap:8px;margin-bottom:15px;flex-wrap:wrap}
.filter-row input{flex:1 1 120px;min-width:0;padding:10px;border:2px solid #FFE0B2;border-radius:10px;font-size:13px}
.filter-row button{flex:0 0 auto;padding:10px 15px;background:#D32F2F;color:white;border:none;border-radius:10px;font-weight:600;cursor:pointer;font-size:13px}
.stats-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:15px}
.stat-box{padding:15px;border-radius:12px;text-align:center}
.stat-box.green{background:#E8F5E9}
.stat-box.red{background:#FFEBEE}
.stat-box.blue{background:#E3F2FD}
.stat-box.purple{background:#F3E5F5}
.stat-box.orange{background:#FFF3E0}
.stat-box.yellow{background:#FFFDE7}
.stat-box h4{font-size:12px;color:#666;margin-bottom:5px}
.stat-box p{font-size:20px;font-weight:700}
.green p{color:#2E7D32}.red p{color:#C62828}.blue p{color:#1565C0}.purple p{color:#6A1B9A}.orange p{color:#E65100}.yellow p{color:#F9A825}
.sale-card{background:#FFFDF7;border:2px solid #FFCC80;border-radius:12px;padding:12px;margin-bottom:10px}
.sale-head{display:flex;justify-content:space-between;margin-bottom:8px}
.sale-date{font-weight:700;color:#D32F2F;font-size:13px}
.sale-total{font-weight:800;color:#2E7D32;font-size:16px}
.sale-items{font-size:12px;color:#555;line-height:1.6}
.exp-card{background:#FFF5F5;border:2px solid #FFCDD2;border-radius:12px;padding:12px;margin-bottom:10px}
.exp-head{display:flex;justify-content:space-between;margin-bottom:8px}
.exp-desc{font-weight:700;color:#C62828;font-size:13px}
.exp-amt{font-weight:800;color:#C62828;font-size:16px}
.loading{text-align:center;padding:40px;color:#666}
.formula{font-size:13px;color:#666;text-align:center;margin-top:10px}
.btn-save-month{width:100%;padding:15px;background:#2E7D32;color:white;border:none;border-radius:12px;font-weight:800;font-size:16px;cursor:pointer;margin-top:10px}
.btn-save-month:disabled{background:#ccc}
.badge{font-size:10px;padding:2px 6px;border-radius:4px;font-weight:700;margin-left:4px}
.badge.orange{background:#FFF3E0;color:#E65100}
.badge.green{background:#E8F5E9;color:#2E7D32}
.badge.red{background:#FFEBEE;color:#C62828}
</style>
</head>
<body>
<div class="header">
<h1>💰 Net Profit Report</h1>
<a href="index.html" class="back-btn">← Back</a>
</div>
<div class="card">
<h3>📊 Select Date Range</h3>
<div class="filter-row">
<input type="date" id="dateFrom">
<input type="date" id="dateTo">
<button id="loadBtn">Load</button>
</div>
<div class="stats-grid">
<div class="stat-box green"><h4>Total Sales</h4><p id="totalSales">₱0</p></div>
<div class="stat-box blue"><h4>Wholesale Sales</h4><p id="wholesaleSales">₱0</p></div>
<div class="stat-box purple"><h4>Retail Sales</h4><p id="retailSales">₱0</p></div>
</div>
<div class="stats-grid">
<div class="stat-box red"><h4>Daily Expenses</h4><p id="totalExpenses">₱0</p></div>
<div class="stat-box purple"><h4>Monthly Expenses</h4><p id="totalMonthlyExp">₱0</p></div>
<div class="stat-box blue"><h4>Daily Net</h4><p id="netProfit">₱0</p></div>
</div>
<div class="stats-grid" style="margin-top:15px">
<div class="stat-box orange" style="grid-column:1/4"><h4>⚠️ Total Unpaid Wholesale</h4><p id="totalUnpaid">₱0</p></div>
</div>
<div class="stats-grid" style="margin-top:15px">
<div class="stat-box yellow" style="grid-column:1/2"><h4>📈 Monthly Income</h4><p id="monthlyIncome">₱0</p></div>
<div class="stat-box purple" style="grid-column:2/4"><h4>💰 Monthly Net Profit</h4><p id="monthlyNetProfit">₱0</p></div>
</div>
<div class="stats-grid" style="margin-top:15px">
<div class="stat-box purple" style="grid-column:1/4"><h4>💵 Tunay na Net Cash Today</h4><p id="realNetCash">₱0</p></div>
</div>
<div class="formula">Formula: Daily Net = Retail - Daily Expenses | Monthly Net = Monthly Income - Monthly Expenses</div>
<button class="btn-save-month" id="saveMonthBtn">💾 Manual Save Daily Net</button>
</div>
<div class="card">
<h3>📋 Sales List - Sorted by Time</h3>
<div id="salesList" class="loading">Loading...</div>
</div>
<div class="card">
<h3>💸 Daily Expenses</h3>
<div id="expensesList" class="loading">Loading...</div>
</div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import { getFirestore, collection, getDocs, addDoc, query, where, doc, setDoc } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

const firebaseConfig = { apiKey: "AIzaSyDk3ZbOXuw3PEfJzdt8AI2ueJq5yksfekE", authDomain: "dhan-siomai-pos-fe1e5.firebaseapp.com", projectId: "dhan-siomai-pos-fe1e5", storageBucket: "dhan-siomai-pos-fe1e5.firebasestorage.app", messagingSenderId: "305932123173", appId: "1:305932123173:web:f27894a2d5e6e6ab8253cc" };
const app = initializeApp(firebaseConfig);
const db = getFirestore(app);

const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];

let d = new Date();
let today = d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
document.getElementById('dateFrom').value = today;
document.getElementById('dateTo').value = today;
let currentNet = 0;
let currentMonth = 0;
let currentYear = 0;
let currentRealNet = 0;

async function loadReport() {
  const from = document.getElementById('dateFrom').value;
  const to = document.getElementById('dateTo').value;
  const salesList = document.getElementById('salesList');
  const expList = document.getElementById('expensesList');

  if(!from ||!to){ alert('Pili ka muna date range boss!'); return; }
  
  salesList.innerHTML = '<div class="loading">Loading sales...</div>';
  expList.innerHTML = '<div class="loading">Loading expenses...</div>';

  let totalSales = 0;
  let wholesaleSales = 0;
  let retailSales = 0;
  let totalExpenses = 0;
  let totalMonthlyExp = 0;
  let unpaidWholesale = 0;
  let monthlyIncome = 0;
  
  const fromDate = new Date(from);
  fromDate.setHours(0,0,0,0);
  const toDate = new Date(to);
  toDate.setHours(23,59,59,999);
  currentMonth = fromDate.getMonth() + 1;
  currentYear = fromDate.getFullYear();

  try {
    // 1. LOAD SALES
    const salesSnap = await getDocs(collection(db, "sales"));
    let salesArray = [];
    salesSnap.forEach(doc => {
      const sale = doc.data();
      const saleDate = sale.timestamp? sale.timestamp.toDate() : new Date();
      if(saleDate >= fromDate && saleDate <= toDate){
        salesArray.push({id: doc.id,...sale, saleDate});
      }
    });

    let html = '';
    if(salesArray.length === 0) {
      salesList.innerHTML = '<div class="loading">Wala pang sales boss</div>';
    } else {
      salesArray.sort((a, b) => a.saleDate - b.saleDate);
      salesArray.forEach(sale => {
        totalSales += Number(sale.total) || 0;
        
        const isPaid = sale.isPaid === undefined ? true : sale.isPaid;
        const isWholesale = sale.status === 'Partial' || Number(sale.change) <= 0;
        
        if(isWholesale){
          wholesaleSales += Number(sale.total) || 0;
          if(!isPaid){
            unpaidWholesale += Number(sale.total) || 0;
          }
        } else {
          retailSales += Number(sale.total) || 0;
        }

        const items = sale.items? sale.items.map(i => {
          const itemTotal = Number(i.total) || (Number(i.price) * Number(i.qty));
          return `${i.name} x${i.qty} = ₱${itemTotal.toLocaleString()}`
        }).join('<br>') : 'No items';
        const time = sale.saleDate.toLocaleTimeString('en-PH', {hour:'2-digit', minute:'2-digit'});
        const type = isWholesale ? (isPaid ? '<span class="badge green">WHSL-PAID</span>' : '<span class="badge red">WHSL-UNPAID</span>') : '<span class="badge green">RTL</span>';
        
        html += `<div class="sale-card">
          <div class="sale-head">
            <span class="sale-date">${sale.saleDate.toLocaleDateString()} ${time}${type}</span>
            <span class="sale-total">₱${Number(sale.total || 0).toLocaleString()}</span>
          </div>
          <div class="sale-items">${items}</div>
        </div>`;
      });
      salesList.innerHTML = html;
    }

    // 2. LOAD DAILY EXPENSES
    const expQ = query(collection(db,"daily_expenses"), where("date",">=",from), where("date","<=",to));
    const expSnap = await getDocs(expQ);
    let expHtml = '';
    if(expSnap.empty){
      expList.innerHTML = '<div class="loading">Wala pang daily expenses boss</div>';
    } else {
      expSnap.forEach(doc => {
        const exp = doc.data();
        totalExpenses += Number(exp.amount) || 0;
        const receiptImg = exp.receipt? `<img src="${exp.receipt}" style="max-width:100px;margin-top:5px;border-radius:8px;border:1px solid #C62828;cursor:pointer" onclick="window.open('${exp.receipt}')">` : '';
        expHtml += `<div class="exp-card">
          <div class="exp-head">
            <span class="exp-desc">${exp.date} - ${exp.desc}</span>
            <span class="exp-amt">-₱${Number(exp.amount || 0).toLocaleString()}</span>
          </div>
          ${receiptImg}
        </div>`;
      });
      expList.innerHTML = expHtml;
    }

    // 3. LOAD MONTHLY EXPENSES
    const monthlyExpQ = query(collection(db,"monthly_expenses"), where("month","==",currentMonth), where("year","==",currentYear));
    const monthlyExpSnap = await getDocs(monthlyExpQ);
    monthlyExpSnap.forEach(doc => {
      totalMonthlyExp += Number(doc.data().amount) || 0;
    });

    // 4. LOAD MONTHLY INCOME
    const monthlyNetQ = query(collection(db,"monthly_net"), where("month","==",currentMonth), where("year","==",currentYear));
    const monthlyNetSnap = await getDocs(monthlyNetQ);
    monthlyNetSnap.forEach(doc => {
      monthlyIncome += Number(doc.data().netAmount) || 0;
    });

    // 5. COMPUTE
    const netProfit = retailSales - totalExpenses;
    const realNetCash = netProfit + wholesaleSales - unpaidWholesale;
    const monthlyNetProfit = monthlyIncome - totalMonthlyExp;
    currentNet = netProfit;
    currentRealNet = realNetCash;

    document.getElementById('totalSales').textContent = '₱' + totalSales.toLocaleString();
    document.getElementById('wholesaleSales').textContent = '₱' + wholesaleSales.toLocaleString();
    document.getElementById('retailSales').textContent = '₱' + retailSales.toLocaleString();
    document.getElementById('totalExpenses').textContent = '₱' + totalExpenses.toLocaleString();
    document.getElementById('netProfit').textContent = '₱' + netProfit.toLocaleString();
    document.getElementById('totalMonthlyExp').textContent = '₱' + totalMonthlyExp.toLocaleString();
    document.getElementById('totalUnpaid').textContent = '₱' + unpaidWholesale.toLocaleString();
    document.getElementById('realNetCash').textContent = '₱' + realNetCash.toLocaleString();
    document.getElementById('monthlyIncome').textContent = '₱' + monthlyIncome.toLocaleString();
    document.getElementById('monthlyNetProfit').textContent = '₱' + monthlyNetProfit.toLocaleString();

    // 6. AUTO SAVE REAL NET CASH TO MONTHLY - BAGO TO
    if(realNetCash > 0 && from === to && from === today){ // Auto save lang pag today
      await autoSaveToMonthly(realNetCash, currentMonth, currentYear, today);
    }

  } catch(e) {
    salesList.innerHTML = '<div class="loading" style="color:red">Error: ' + e.message + '</div>';
    console.error(e);
  }
}

async function autoSaveToMonthly(amount, month, year, dateStr){
  try{
    // Gamit natin yung date as ID para isang beses lang per day
    await setDoc(doc(db, "monthly_net", `${year}-${month}-${dateStr}`), {
      month: month,
      year: year,
      netAmount: amount,
      date: dateStr,
      timestamp: new Date()
    });
  }catch(e){
    console.log("Auto save error:", e.message);
  }
}

// MANUAL SAVE BUTTON - backup lang to
document.getElementById('saveMonthBtn').addEventListener('click', async ()=>{
  if(currentRealNet <= 0){ alert('Wala pang net cash boss para i-save.'); return; }
  if(!confirm(`Manual Save ₱${currentRealNet.toLocaleString()} as Net Cash for ${months[currentMonth-1]} ${currentYear}?`)){ return; }
  const btn = document.getElementById('saveMonthBtn');
  btn.disabled = true;
  btn.innerText = 'Saving...';
  try{
    await autoSaveToMonthly(currentRealNet, currentMonth, currentYear, today);
    alert(`✓ Saved! ₱${currentRealNet.toLocaleString()} na-save sa Monthly Income.`);
    loadReport();
  }catch(e){
    alert('Error: '+e.message);
  }finally{
    btn.disabled = false;
    btn.innerText = '💾 Manual Save Daily Net';
  }
});

document.getElementById('loadBtn').addEventListener('click', loadReport);
loadReport();
</script>
</body>
</html>
